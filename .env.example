# Non-superuser Postgres connection enforcing RLS
DATABASE_URL=postgres://app_user:pass@localhost:5432/analytics

# Owner connection used solely by Drizzle migrations
DATABASE_MIGRATION_URL=postgres://postgres:pass@localhost:5432/analytics

# Redis for sliding window rate limiting, API key cache, BullMQ, SSE Pub/Sub
REDIS_URL=redis://localhost:6379

# AES-256-GCM 32-byte key (64 hex chars) for encrypting whsec_ secrets at rest
ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session cookie signing secret (32+ bytes)
AUTH_SECRET=dGhpc2lzYXNlY3JldGtleWZvcnNlc3Npb25zb2ZhdGxlYXN0MzJieXRlcw==

# Max events buffered before bulk PostgreSQL insert
INGEST_BATCH_SIZE=100

# Hard outbound HTTP timeout per webhook attempt (ms)
WEBHOOK_TIMEOUT_MS=5000

# Bearer secret authorizing Vercel cron reseed route
CRON_SECRET=sample_cron_secret_minimum_32_characters_random_hex

# Server-side demo workspace credentials
DEMO_USER_EMAIL=demo@eventpulse.dev
DEMO_USER_PASSWORD=sample_demo_workspace_password_123
